{
  "name": "sakura-browser",
  "version": "1.0.0",
  "description": "Anime-style lightweight browser",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.sakura.browser",
    "productName": "SakuraBrowser",
    "win": { "target": "portable" },
    "files": ["main.js", "package.json"]
  }
}
